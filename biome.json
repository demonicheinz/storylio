{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "includes": [
      "src/components/ui/**",
      "src/lib/**",
      "src/features/dashboard/settings/**",
      "src/features/dashboard/home/**",
      "src/features/dashboard/shell/**",
      "src/features/dashboard/posts/**",
      "src/features/dashboard/projects/**",
      "src/features/dashboard/gallery/**",
      "src/features/dashboard/media/**",
      "src/features/dashboard/about/**",
      "src/features/dashboard/analytics/**",
      "src/components/auth/**",
      "src/features/dashboard/shared/**",
      "src/app/**/*.{ts,tsx,css}",
      "src/components/public/**/*.{ts,tsx}"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
