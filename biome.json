{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "includes": [
      "src/components/ui/**",
      "src/lib/**",
      "src/features/dashboard/settings/**",
      "src/features/dashboard/home/**",
      "src/features/dashboard/shell/**",
      "src/features/dashboard/posts/**",
      "src/features/dashboard/projects/**",
      "src/features/dashboard/gallery/**",
      "src/features/dashboard/media/**",
      "src/features/dashboard/about/**",
      "src/features/dashboard/analytics/**",
      "src/components/auth/**",
      "src/features/dashboard/shared/**",
      "src/app/**/*.{ts,tsx,css}",
      "src/components/public/**",
      "src/hooks/**",
      "src/components/common/**",
      "src/components/effects/gravity-stars.tsx",
      "scripts/**",
      "tests/helpers/**",
      "tests/**/*.test.ts",
      "tests/browser/dashboard-settings.js",
      "tests/browser/dashboard-analytics.js",
      "tests/browser/star-lifecycle.js",
      "tests/browser/venom-context-recovery.js",
      "tests/browser/about-highlight-keys.js",
      "tests/browser/auth-recovery-form.js",
      "tests/browser/collection-layout.js",
      "tests/browser/content-covers.js",
      "tests/browser/content-navigation.js",
      "tests/browser/control-cursors.js",
      "tests/browser/dashboard-about.js",
      "tests/browser/dashboard-filters.js",
      "tests/browser/dashboard-gallery.js",
      "tests/browser/dashboard-posts.js",
      "tests/browser/dashboard-system.js",
      "tests/browser/drawer-handle.js",
      "tests/browser/editor-autosave.js",
      "tests/browser/gallery-editor.js",
      "tests/browser/gooey-navigation.js",
      "tests/browser/image-upload-limits.js",
      "tests/browser/media-deletion.js",
      "tests/browser/media-detail-panel.js",
      "tests/browser/media-upload-queue.js",
      "tests/browser/post-scheduling.js",
      "tests/browser/posts-publication-clock.js",
      "tests/browser/project-editor-consistency.js",
      "tests/browser/project-list-presentation.js",
      "tests/browser/projects-reorder.js",
      "tests/browser/public-detail-status.js",
      "tests/browser/security-smoke.js",
      "tests/browser/sidebar-mobile.js",
      "tests/browser/sidebar-motion.js",
      "tests/browser/sidebar-storage.js",
      "tests/browser/star-paused-twinkle.js",
      "tests/browser/venom-fallback.js",
      "tests/browser/venom-wrapper-recovery.js",
      "tests/browser/webgl-lifecycle.js",
      "tests/browser/asset-selection-keyboard.js",
      "tests/browser/collection-selection-keyboard.js",
      "tests/browser/dashboard-media.js",
      "tests/browser/dashboard-projects.js",
      "tests/browser/dashboard-sort.js",
      "tests/browser/filter-prefetch.js",
      "tests/browser/mdx-source.js",
      "tests/browser/posts-batch-selection.js",
      "tests/browser/projects-batch-actions.js",
      "tests/browser/projects-mobile-toolbar.js",
      "tests/browser/about-language.js",
      "tests/browser/about-polish.js",
      "tests/browser/article-reading.js",
      "tests/browser/auth-entrance.js",
      "tests/browser/auth-navigation.js",
      "tests/browser/auth-sky.js",
      "tests/browser/base-ui-smoke.js",
      "tests/browser/code-block-scroll.js",
      "tests/browser/gallery-polish.js",
      "tests/browser/gallery-touch.js",
      "tests/browser/hero-entrance.js",
      "tests/browser/home-redesign.js",
      "tests/browser/home-smooth-scroll.js",
      "tests/browser/project-card-content.js",
      "tests/browser/project-cards-motion.js",
      "tests/browser/project-depth-carousel.js",
      "tests/browser/project-depth-keyboard.js",
      "tests/browser/project-depth-touch.js",
      "tests/browser/project-detail-polish.js",
      "tests/browser/public-navigation.js",
      "tests/browser/public-smooth-scroll.js",
      "tests/browser/public-surface.js",
      "tests/browser/public-typography.js",
      "tests/browser/recovery-boundaries.js",
      "tests/browser/sign-in-polish.js",
      "tests/browser/writing-archive.js"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**/*.module.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownPseudoClass": {
              "level": "error",
              "options": {
                "ignore": ["global", "local"]
              }
            }
          }
        }
      }
    }
  ]
}
