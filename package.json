{
  "name": "storylio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome check --write --no-errors-on-unmatched",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "browser": "playwright-cli -s=storylio-security",
    "browser:install": "playwright-cli install-browser chromium",
    "browser:open": "playwright-cli -s=storylio-security open --config=playwright-cli.config.json",
    "test:browser": "playwright-cli -s=storylio-security run-code --filename=tests/browser/security-smoke.js",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "postinstall": "prisma generate",
    "dev": "infisical sm run --env=dev --path=/ -- next dev",
    "dev:preview": "infisical sm run --env=staging --path=/ -- next dev",
    "dev:production": "infisical sm run --env=prod --path=/ -- next dev",
    "build": "infisical sm run --env=dev --path=/ -- next build",
    "build:hosted": "next build",
    "build:preview": "infisical sm run --env=staging --path=/ -- next build",
    "build:production": "infisical sm run --env=prod --path=/ -- next build",
    "start": "infisical sm run --env=dev --path=/ -- next start",
    "start:preview": "infisical sm run --env=staging --path=/ -- next start",
    "start:production": "infisical sm run --env=prod --path=/ -- next start",
    "db:format": "infisical sm run --env=dev --path=/ -- prisma format",
    "db:generate": "infisical sm run --env=dev --path=/ -- prisma generate",
    "db:generate:preview": "infisical sm run --env=staging --path=/ -- prisma generate",
    "db:generate:production": "infisical sm run --env=prod --path=/ -- prisma generate",
    "db:migrate": "infisical sm run --env=dev --path=/ -- prisma migrate dev",
    "db:migrate:preview": "infisical sm run --env=staging --path=/ -- prisma migrate deploy",
    "db:migrate:production": "infisical sm run --env=prod --path=/ -- prisma migrate deploy",
    "db:status": "infisical sm run --env=dev --path=/ -- prisma migrate status",
    "db:status:preview": "infisical sm run --env=staging --path=/ -- prisma migrate status",
    "db:status:production": "infisical sm run --env=prod --path=/ -- prisma migrate status",
    "db:push": "infisical sm run --env=dev --path=/ -- prisma db push",
    "db:push:preview": "infisical sm run --env=staging --path=/ -- prisma db push",
    "db:seed": "infisical sm run --env=dev --path=/ -- prisma db seed",
    "db:seed:preview": "infisical sm run --env=staging --path=/ -- prisma db seed",
    "db:seed:production": "infisical sm run --env=prod --path=/ -- prisma db seed",
    "db:studio": "infisical sm run --env=dev --path=/ -- prisma studio",
    "db:studio:preview": "infisical sm run --env=staging --path=/ -- prisma studio",
    "db:reset": "infisical sm run --env=dev --path=/ -- prisma migrate reset",
    "db:backfill-media": "infisical sm run --env=dev --path=/ -- tsx scripts/backfill-media-metadata.ts",
    "db:backfill-gallery": "infisical sm run --env=dev --path=/ -- tsx scripts/backfill-gallery-metadata.ts",
    "db:backfill-images": "bun run db:backfill-media && bun run db:backfill-gallery"
  },
  "dependencies": {
    "@better-auth/passkey": "~1.6.33",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdxeditor/editor": "^4.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/fiber": "^9.6.1",
    "better-auth": "~1.6.33",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "mdast-util-highlight-mark": "^1.2.2",
    "micromark-extension-highlight-mark": "^1.2.0",
    "motion": "^12.40.0",
    "next": "16.4.2",
    "next-mdx-remote-client": "^2",
    "prisma": "^7.10.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.77.0",
    "react-photo-album": "^3.6.0",
    "recharts": "^3.8.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "0.182",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/cli": "0.1.22",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "~4.1.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "resolutions": {
    "js-yaml": "^4.3.2",
    "@hono/node-server": "^1.19.15"
  }
}
