{
  "name": "storylio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome check --write --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "postinstall": "prisma generate",
    "dev": "dotenvx run -f .env.local -- next dev",
    "dev:preview": "dotenvx run -f .env.preview -- next dev",
    "dev:production": "dotenvx run -f .env.production -- next dev",
    "build": "dotenvx run -f .env.local -- next build",
    "build:preview": "dotenvx run -f .env.preview -- next build",
    "build:production": "dotenvx run -f .env.production -- next build",
    "start": "dotenvx run -f .env.local -- next start",
    "start:preview": "dotenvx run -f .env.preview -- next start",
    "start:production": "dotenvx run -f .env.production -- next start",
    "db:format": "dotenvx run -f .env.local -- prisma format",
    "db:generate": "dotenvx run -f .env.local -- prisma generate",
    "db:generate:preview": "dotenvx run -f .env.preview -- prisma generate",
    "db:generate:production": "dotenvx run -f .env.production -- prisma generate",
    "db:migrate": "dotenvx run -f .env.local -- prisma migrate dev",
    "db:migrate:preview": "dotenvx run -f .env.preview -- prisma migrate deploy",
    "db:migrate:production": "dotenvx run -f .env.production -- prisma migrate deploy",
    "db:status": "dotenvx run -f .env.local -- prisma migrate status",
    "db:status:preview": "dotenvx run -f .env.preview -- prisma migrate status",
    "db:status:production": "dotenvx run -f .env.production -- prisma migrate status",
    "db:push": "dotenvx run -f .env.local -- prisma db push",
    "db:push:preview": "dotenvx run -f .env.preview -- prisma db push",
    "db:seed": "dotenvx run -f .env.local -- prisma db seed",
    "db:seed:preview": "dotenvx run -f .env.preview -- prisma db seed",
    "db:seed:production": "dotenvx run -f .env.production -- prisma db seed",
    "db:studio": "dotenvx run -f .env.local -- prisma studio",
    "db:studio:preview": "dotenvx run -f .env.preview -- prisma studio",
    "db:reset": "dotenvx run -f .env.local -- prisma migrate reset",
    "db:backfill-media": "dotenvx run -f .env.local -- tsx scripts/backfill-media-metadata.ts",
    "db:backfill-gallery": "dotenvx run -f .env.local -- tsx scripts/backfill-gallery-metadata.ts",
    "db:backfill-images": "bun run db:backfill-media && bun run db:backfill-gallery"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdxeditor/editor": "^4.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/fiber": "^9.6.1",
    "@vercel/og": "^0.11.1",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "mdast-util-highlight-mark": "^1.2.2",
    "micromark-extension-highlight-mark": "^1.2.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "next-mdx-remote-client": "^2",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.77.0",
    "react-photo-album": "^3.6.0",
    "recharts": "^3.8.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "0.182",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@dotenvx/dotenvx": "^1.69.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "resolutions": {
    "js-yaml": "^4.2.0",
    "@hono/node-server": "^1.19.13"
  }
}
