# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Site and Better Auth
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production canonical URL and local fallback. Better Auth derives the active
# origin for allowed Vercel Preview deployments automatically.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-strong-seed-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="storylio"

# Transactional email
RESEND_API_KEY=""
RESEND_FROM="Storylio <noreply@example.com>"
# RESEND_REPLY_TO=""

# Optional GitHub OAuth
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# OWNER_GITHUB_ID=""

# Optional self-hosted Umami tracking and dashboard API
# UMAMI_WEBSITE_ID=""
# UMAMI_SCRIPT_URL=""
# UMAMI_API_URL=""
# UMAMI_USERNAME=""
# UMAMI_PASSWORD=""
# UMAMI_SHARE_URL=""
# UMAMI_TRACK_LOCALHOST="false"
