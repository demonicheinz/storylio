# ========== General Rules ==========

# Use LF line endings for all text files (cross-platform consistency)
* text=auto eol=lf

# Force LF for common code/config files
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.md      text eol=lf
*.mdx     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.env*    text eol=lf

# SVG is text/XML, keep it diffable
*.svg     text eol=lf

# Windows scripts may use CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# ========== Binary / Non-Text Files ==========
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.mp4     binary
*.webm    binary
*.mov     binary
*.pdf     binary
*.zip     binary

# ========== OS-Specific ==========
.DS_Store export-ignore
Thumbs.db export-ignore