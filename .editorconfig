root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Drizzle hashes generated SQL bytes; preserve migration file endings.
[drizzle/*.sql]
insert_final_newline = false
trim_trailing_whitespace = false
